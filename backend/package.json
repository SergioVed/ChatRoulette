{
  "name": "teacher-student-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for TeacherStudent",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test .test-dist/src/*.spec.js .test-dist/test/*.e2e-spec.js",
    "test:e2e": "npm run test:build && node --test .test-dist/test/*.e2e-spec.js",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-ws": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.2",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^12.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
